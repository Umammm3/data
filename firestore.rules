rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: items
    // Document ID: auto-generated
    // Fields:
    //   - code: string (required, unique-ish via app logic)
    //   - name: string (required)
    //   - date: string (required, YYYY-MM-DD)
    //   - description: string (optional)
    //   - createdAt: number (required)
    //
    // ===============================================================

    // Helper Functions
    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function isValidItem(data) {
      return data.code is string && data.code.size() > 0 && data.code.size() < 100 &&
             data.name is string && data.name.size() > 0 && data.name.size() < 200 &&
             data.date is string && data.date.matches("^\\d{4}-\\d{2}-\\d{2}$") &&
             (data.description is string && data.description.size() < 1000) &&
             data.createdAt is number;
    }

    match /items/{itemId} {
      // Allow everyone to read the list as requested
      allow read: if true;
      
      // Allow creation with validation
      allow create: if hasRequiredFields(['code', 'name', 'date', 'createdAt']) &&
                      hasOnlyAllowedFields(['code', 'name', 'date', 'description', 'createdAt']) &&
                      isValidItem(request.resource.data);
      
      // Allow deletion (password check is handled in the app, but rules protect the path)
      // Since there's no auth, we allow delete for now. 
      // In a real app, we'd use auth or a secret field.
      allow delete: if true;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
